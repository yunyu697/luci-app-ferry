{
	"luci-app-ferry": {
		"description": "Grant access to Ferry configuration, node store and profiles",
		"read": {
			"uci": [ "ferry" ],
			"ubus": {
				"luci-ferry-kernel": [ "list", "status", "versions", "job", "mirrors", "mirror_test", "preview" ],
				"luci-ferry-safety": [ "status" ],
				"luci-ferry-upgrade": [ "status", "snapshot", "verify" ]
			},
			"file": {
				"/etc/ferry/nodes.json": [ "read" ],
				"/etc/ferry/profiles.json": [ "read" ],
				"/etc/ferry/status.json": [ "read" ],
				"/etc/ferry/nodes.lst": [ "read" ],
				"/etc/ferry/rules.lst": [ "read" ],
				"/etc/ferry/custom.lst": [ "read" ],
				"/etc/mihomo/config.yaml": [ "read" ],
				"/etc/sing-box/config.json": [ "read" ],
				"/etc/mihomo/*.yaml": [ "read" ],
				"/etc/mihomo/*.yml": [ "read" ],
				"/etc/sing-box/*.json": [ "read" ],
				"/etc/ferry/config/*": [ "read" ]
			}
		},
		"write": {
			"uci": [ "ferry" ],
			"ubus": {
				"service": [ "reload", "list" ],
				"luci-ferry-kernel": [ "list", "status", "versions", "job", "start", "remove", "mirrors", "mirror_set", "mirror_test", "preview" ],
				"luci-ferry-safety": [ "status", "confirm", "rollback", "disable", "enable", "diag", "diag_download" ],
				"luci-ferry-upgrade": [ "status", "snapshot", "verify", "restore", "prep", "remove" ]
			},
			"file": {
				"/etc/ferry/nodes.json": [ "write" ],
				"/etc/ferry/profiles.json": [ "write" ],
				"/etc/ferry/nodes.lst": [ "write" ],
				"/etc/ferry/rules.lst": [ "write" ],
				"/etc/ferry/custom.lst": [ "write" ],
				"/etc/init.d/ferry": [ "exec" ],
				"/usr/bin/ferry-txnctl": [ "exec" ],
				"/usr/bin/ferry-diag": [ "exec" ],
				"/usr/bin/ferry-sysupgrade": [ "exec" ]
			}
		}
	}
}
