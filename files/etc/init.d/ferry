#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

. /usr/lib/ferry/common.sh
. /usr/lib/ferry/nodes.sh
. /usr/lib/ferry/rules.sh
. /usr/lib/ferry/generate.sh
. /usr/lib/ferry/firewall.sh
. /usr/lib/ferry/transaction.sh

pm_start_kernel() {
	local bin cfg
	bin=$(pm_kernel_bin)

	procd_open_instance
	if [ "$PM_KERNEL" = singbox ]; then
		cfg="${PM_RUNTIME_CONFIG:-$PM_SINGBOX_DIR/config.json}"
		procd_set_param command "$bin" run -c "$cfg" -D "$PM_SINGBOX_DIR"
	else
		if [ -n "$PM_CONFIG_PATH" ] && [ -f "$PM_CONFIG_PATH" ] && [ "$PM_RUNTIME_CONFIG" = "$PM_CONFIG_PATH" ]; then
			procd_set_param command "$bin" -d "$PM_MIHOMO_DIR" -f "$PM_CONFIG_PATH"
		else
			procd_set_param command "$bin" -d "$PM_MIHOMO_DIR"
		fi
	fi
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	PM_RUNTIME_CONFIG=''
	pm_load

	# 崩溃/断电兜底：启动时发现未确认事务，先还原到快照基线，再按旧配置启动
	# 事务内部的 stop/start（PM_TXN_SKIP=1）必须跳过，否则会把刚写入的待确认事务当成崩溃残留回滚掉
	if [ "$PM_TXN_SKIP" != 1 ] && pt_pending_exists; then
		pm_log "检测到未确认的应用事务，启动时自动还原" warning
		# 刚开机不可能有还原进程在跑，清掉断电残留的锁
		if [ "$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 999)" -lt 120 ]; then
			rm -rf "$PM_TXN_LOCK"
		fi
		pt_rollback "startup-detect" instart
		PM_RUNTIME_CONFIG=''
		pm_load
	fi

	# 临时关闭标记优先：重启后也保持关闭，直到用户点“恢复”
	if pt_tmp_off_active; then
		pm_log "处于「临时关闭代理」状态，跳过启动（恢复请执行 ferry-txnctl enable）"
		return 0
	fi

	if [ "$PM_ENABLED" != 1 ]; then
		pm_log "服务未启用（ferry.main.enabled=0），跳过启动"
		return 0
	fi

	if ! pm_prepare; then
		pm_log "配置准备失败，服务不会启动，局域网保持直连" err
		return 1
	fi

	pm_log "启动内核：$(pm_kernel_bin) (profile=$PM_PROFILE_ID deploy=$PM_DEPLOY kernel=$PM_KERNEL mode=$PM_MODE)"
	pm_start_kernel

	# 注意：procd 要等本脚本返回后才真正 spawn 实例，所以这里不能等端口就绪
	# （在真机上表现为死等 20 秒超时、规则和 dnsmasq 永远装不上）。
	# 配置合法性已在 pm_prepare 里用内核自检确认，直接装接管规则；
	# 若内核起不来，procd 会按 respawn 策略拉起并在 LuCI 状态里暴露告警。
	if pm_fw_up; then
		pm_dnsmasq_apply
		pm_status_write
		# 正常启动（非事务内部）时，把当前配置记为“已确认基线”，供首次回滚使用
		if [ "$PM_TXN_SKIP" != 1 ]; then
			pt_save_baseline
		fi
		if pm_is_client; then
			pm_log "客户端形态已就绪：mixed 端口 $PM_MIXED_PORT"
		else
			pm_log "已启动并接管局域网流量"
		fi
	else
		pm_log "接管规则安装失败，局域网保持直连" err
		pm_status_write
		return 1
	fi
	return 0
}

stop_service() {
	pm_load
	pm_fw_down
	pm_dnsmasq_restore
	pm_status_write
	pm_log "已停止，接管规则已清理"
	return 0
}

reload_service() {
	pm_load

	# 内部还原流程重启时不再创建新事务
	if [ "$PM_TXN_SKIP" = 1 ]; then
		stop
		start
		return $?
	fi

	if pt_tmp_off_active; then
		# 临时关闭期间保存配置：保持关闭，等用户显式恢复
		PM_TXN_SKIP=1 stop
		pm_log "临时关闭状态下的配置已保存，服务保持关闭"
		return 0
	fi

	# 应用事务：先写快照（含当前 nft/ip/dnsmasq/进程状态），再 stop/start
	if ! pt_begin "apply"; then
		pm_log "事务快照失败，仍执行应用但不提供自动回滚" err
		stop
		start
		return $?
	fi

	# 事务内部的 stop/start 不能触发“启动时检测 pending 自动还原”
	PM_TXN_SKIP=1 stop
	PM_TXN_SKIP=1 start
	local rc=$?
	PM_TXN_SKIP=''

	# start_service 返回非 0，或内核进程没起来，都视为应用失败并立即回滚
	if [ "$rc" -eq 0 ] && [ "$PM_ENABLED" = 1 ] && ! pm_is_client; then
		local i=0
		while [ "$i" -lt 5 ]; do
			pgrep -f "$(pm_kernel_bin)" >/dev/null 2>&1 && break
			sleep 1
			i=$((i + 1))
		done
		pgrep -f "$(pm_kernel_bin)" >/dev/null 2>&1 || rc=1
	fi

	if [ "$rc" -ne 0 ]; then
		pm_log "应用失败（rc=$rc），立即按快照还原" err
		pt_rollback "apply-failed" full
		return "$rc"
	fi

	pt_arm "apply"

	# 看门狗正常情况下由 procd 常驻；这里兜底确保它存在
	if [ -x /etc/init.d/ferry-watchdog ] && ! pgrep -f /usr/lib/ferry/watchdog.sh >/dev/null 2>&1; then
		/etc/init.d/ferry-watchdog start >/dev/null 2>&1
	fi
	pm_log "应用完成，等待用户确认（$(pt_timeout) 秒）"
	return 0
}

service_triggers() {
	procd_add_reload_trigger "ferry"
}

status_service() {
	pm_load
	local bin
	bin=$(pm_kernel_bin)

	if pgrep -f "$bin" >/dev/null 2>&1; then
		echo "ferry: running (profile=$PM_PROFILE_ID deploy=$PM_DEPLOY kernel=$PM_KERNEL mode=$PM_MODE port=$PM_PROXY_PORT)"
	else
		echo "ferry: stopped (profile=$PM_PROFILE_ID deploy=$PM_DEPLOY)"
	fi

	if pm_is_client; then
		echo "firewall: skipped (client deploy)"
	elif nft list tables 2>/dev/null | grep -q "ferry"; then
		echo "firewall: nft table active"
	elif iptables -t nat -S PM_DNS >/dev/null 2>&1 || iptables -t nat -S PM_REDIR >/dev/null 2>&1; then
		echo "firewall: iptables chains active"
	else
		echo "firewall: no rules"
	fi

	echo "content: nodes=$(pm_count_nodes) rules=$(pm_count_rules)"
	# 运行时包管理器：OpenWRT main/apk 分支为 apk，23.05/24.10 与 ImmortalWrt 为 opkg
	local mgr
	mgr=$(pm_pkgmgr)
	echo "package_manager: ${mgr:-none}"
	if [ "$mgr" = apk ]; then
		echo "install_hint: $(pm_pkg_install_hint '<包文件>.apk')"
	else
		echo "install_hint: $(pm_pkg_install_hint '<包文件>.ipk')"
	fi
	# 依赖快速自检：只提示缺失，不阻止服务运行（iptables 兼容栈刻意非硬依赖）
	# 按“能力”判断而不是包名：OpenWrt 的 nft 包名有 nftables / nftables-json / nftables-no-json 等变体
	local missing
	missing=''
	command -v nft >/dev/null 2>&1 || missing="$missing nftables"
	command -v ip >/dev/null 2>&1 || missing="$missing ip-full"
	command -v uclient-fetch >/dev/null 2>&1 || missing="$missing uclient-fetch"
	[ -z "$missing" ] || echo "missing_deps:$missing"

	if pt_pending_exists; then
		echo "transaction: pending confirm (id=$(pt_meta_get id) left=$(($(pt_meta_get deadline) - $(pt_now)))s)"
	else
		echo "transaction: none"
	fi
	if pt_tmp_off_active; then
		echo "temporary: off (use ferry-txnctl enable)"
	fi

	if [ -f "$(pm_dnsmasq_backup_dir)/server" ]; then
		echo "dnsmasq: upstream rewritten to 127.0.0.1#$PM_DNS_PORT"
	fi
	if [ -s "$PM_STATUS_FILE" ]; then
		echo "status: $PM_STATUS_FILE"
	fi
	return 0
}
